# =============================================================================
# ENV CONFIGURATION TEMPLATE — BAWANG GORENG JURAGAN AUTOMATION
# =============================================================================
# Salin file ini menjadi `.env` di folder yang sama dan isi nilai variabelnya.

# 1. Google Gemini API Key (Dari https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Instagram Direct Login (Mode Instagrapi - Tanpa Meta Developer)
INSTAGRAM_USERNAME=juragan_bawang_username
INSTAGRAM_PASSWORD=juragan_bawang_password

# 3. Meta Official Graph API (Mode Official Meta Developer - Opsional)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
META_ACCESS_TOKEN=your_long_lived_meta_access_token
IMGBB_API_KEY=your_imgbb_api_key_for_temporary_image_hosting

# 4. Google Drive Auto-Sync Configuration
GDRIVE_FOLDER_ID=18pLNfIbRsiA_3kKdrnuTc3SUvoF-WsHd
GDRIVE_SERVICE_ACCOUNT_FILE=service_account.json
GDRIVE_OAUTH_CREDENTIALS_FILE=credentials.json
